.analytics-legend span{display:inline-flex;align-items:center;gap:5px}.analytics-legend i{width:11px;height:11px;display:inline-block;border-radius:3px}
.analytics-svg{width:100%;height:auto;max-height:350px}

.admin-toggle{display:block;text-align:center;font-size:12px;margin-top:15px;cursor:pointer;color:#087886;text-decoration:underline;font-weight:bold;}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:100;display:flex;justify-content:center;align-items:center;}
.modal-box{background:white;padding:20px;border-radius:12px;width:90%;max-width:650px;max-height:90vh;overflow-y:auto;}

.db-table{width:100%;border-collapse:collapse;margin-top:10px;font-size:12px;}
.db-table th,.db-table td{padding:8px;border:1px solid #dce7ed;text-align:left;vertical-align:top;}
.db-table th{background:#f1f5f9;}
.status-badge.aktif{background:#dcfce7;color:#166534;padding:3px 6px;border-radius:4px;font-weight:bold;}
.status-badge.gugur{background:#fee2e2;color:#991b1b;padding:3px 6px;border-radius:4px;font-weight:bold;}
.status-badge.menunggu{background:#fef3c7;color:#b45309;padding:3px 6px;border-radius:4px;font-weight:bold;}

details.admin-accordion{background:white;border:1px solid #dce7ed;border-radius:8px;margin-bottom:10px;}
