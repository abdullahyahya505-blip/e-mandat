 ['BORANG_BDR','BORANG_UR'].forEach(name=>{const b=name==='BORANG_BDR';if(rows_(sheet_(name),b?20:23).some(r=>r[2]===u.id&&r[b?7:8]<=p.akhir&&r[b?8:9]>=p.mula&&r[b?12:15]!=='TIDAK DISOKONG'&&r[b?16:19]!=='TIDAK DILULUSKAN'))throw Error('Borang bertindih masih aktif. Hubungi pentadbir untuk pembetulan.');});
 Object.keys(p).forEach(k=>{if(typeof p[k]==='string')p[k]=safe_(p[k]);});
