const USER_HEAD = ['ID STAF','PERANAN','SKOP','STATUS','SALT PIN','HASH PIN','MODUL_AKSES','SIGNATURE','STAMP','GAGAL LOGIN','KUNCI SEHINGGA','RESET_COUNT', 'WAJIB TUKAR PIN'];

let executionSpreadsheet_;
function ss_(){
  if(executionSpreadsheet_)return executionSpreadsheet_;
  const id = PropertiesService.getScriptProperties().getProperty('EMANDAT_SHEET_ID');
  const ss = id ? SpreadsheetApp.openById(id) : SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) throw Error('Tetapkan EMANDAT_SHEET_ID dalam Script Properties.');
  executionSpreadsheet_=ss;return ss;
}

function sheet_(name){
 const sh=ss_().getSheetByName(name);
 if(!sh) throw Error('Tab '+name+' tiada. Jalankan setupEMandat_ melalui editor.');
 return sh;
}

function rows_(sh,width){
 if(sh.getLastRow()<2)return [];
 const n=Math.min(width,sh.getLastColumn());
 return sh.getRange(2,1,sh.getLastRow()-1,n).getValues().map(row=>{
   const r=row.map(x=>x instanceof Date?Utilities.formatDate(x,'Asia/Kuala_Lumpur','yyyy-MM-dd'):String(x==null?'':x).trim());
   while(r.length<width)r.push('');return r;
 });
}

function setRow_(sh, rIndex, dataArr) {
  if (!sh) return;
  const needed = dataArr.length;
  if (sh.getMaxColumns() < needed) sh.insertColumnsAfter(sh.getMaxColumns(), needed - sh.getMaxColumns());
  sh.getRange(rIndex, 1, 1, needed).setValues([dataArr]);
}

function uuid_(){return Utilities.getUuid().replace(/-/g,'');}
function sha_(value){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('');}
function hash_(secret, salt) {
  let h = secret + '|' + salt + '|IPGKPM_STABIL_2026';
  for (let i = 0; i < 20; i++) h = sha_(h);
  return h;
}

function verifyPin_(pin,r){
 if(!r[4] || !r[5] || r[5]==='BYPASS')return false;
 if(hash_(pin,r[4])===r[5])return true;
 let h=pin+'|'+r[4]+'|IPGKPM_STABIL_2026';
 for(let i=0;i<50;i++)h=sha_(h);
 return h===r[5];
}

function norm_(x){return String(x||'').trim();}
function safe_(v){v=norm_(v);return /^[=+@\-\t\r]/.test(v)?"'"+v:v;}
function getSecret_(str) { return Utilities.newBlob(Utilities.base64Decode(str)).getDataAsString(); }

function doGet(){
 return HtmlService.createHtmlOutputFromFile('Index').setTitle('e-MANDAT • IPGK PM').addMetaTag('viewport','width=device-width,initial-scale=1');
}

function userRow_(id){
  let sh = sheet_('PENGGUNA');
  if (!sh) return {sh:null, idx:-1, row:null};
  let rs = rows_(sh,Math.max(13,sh.getLastColumn()));
  let target = String(id).trim().toUpperCase();
  let foundIdx = -1;
  for (let k = rs.length - 1; k >= 0; k--) {
    if (String(rs[k][0]).trim().toUpperCase() === target) {
      foundIdx = k;
      break;
    }
  }
  return {sh, idx: foundIdx < 0 ? -1 : foundIdx + 2, row: foundIdx < 0 ? null : rs[foundIdx]};
}

function staff_(id){return rows_(sheet_('STAF'),8).filter(r=>r[0]===id && r[6]!=='GUGUR');}

function myToday_(){return Utilities.formatDate(new Date(),'Asia/Kuala_Lumpur','yyyy-MM-dd');}
function parseDay_(s){return new Date(s+'T12:00:00Z');}
function monday_(date){const d=parseDay_(date);const dow=d.getUTCDay();d.setUTCDate(d.getUTCDate()-((dow+6)%7));return d.toISOString().slice(0,10);}
function addDays_(date,n){const d=parseDay_(date);d.setUTCDate(d.getUTCDate()+n);return d.toISOString().slice(0,10);}
function weekDays_(date){const m=monday_(date);return [0,1,2,3,4].map(i=>addDays_(m,i));}

// LOG MASUK YANG MENGHANTAR PROFIL PENUH & MODUL SEBENAR SERTA-MERTA
function login(rawId,pin,isAdminLogin){
 return locked_(()=>{
  assertReady_();
  let id=norm_(rawId).toUpperCase();pin=String(pin||'');
  if(!id||!pin)return {error:'Sila pilih staf dan masukkan kata laluan.'};
  const obj=userRow_(id),r=obj.row;
  if(!r || !staff_(id).length)return {error:'Akaun tidak ditemui. Hubungi pentadbir.'};
  if(!['AKTIF','MENUNGGU PIN'].includes(r[3]))return {error:'Akaun tidak aktif atau sedang menunggu reset.'};
  if(r[10] && Date.parse(r[10])>Date.now())return {error:'Akaun dikunci sementara. Cuba selepas 15 minit.'};
  if(!verifyPin_(pin,r)){
   r[9]=Number(r[9]||0)+1;
   if(r[9]>=5){r[10]=new Date(Date.now()+15*60000).toISOString();r[9]=0;}
   setRow_(obj.sh,obj.idx,r);
   return {error:'Kata laluan tidak sah. Jika kata laluan lama tidak serasi, mohon reset kepada pentadbir.'};
  }
  if(isAdminLogin && r[1]==='STAF' && !r[6])return {error:'Akaun ini bukan pentadbir. Gunakan log masuk staf.'};
  r[9]=0;r[10]='';setRow_(obj.sh,obj.idx,r);
  if(r[12]==='YA'){
   const t=uuid_()+uuid_();
   CacheService.getScriptCache().put('change_'+t,JSON.stringify({id,hash:r[5]}),600);
   return {mustChangePin:true,changeToken:t};
  }
  const token=uuid_()+uuid_();
  CacheService.getScriptCache().put('sess_'+token,JSON.stringify({id,hash:r[5]}),21600);
  const user=session_(token);
  return {token,role:user.role,scope:user.scope,modules:user.modules,user};
 });
}

function session_(token){
 assertReady_();
 const raw=CacheService.getScriptCache().get('sess_'+norm_(token));
 if(!raw)throw Error('Sesi tamat. Sila log masuk semula.');
 const claim=JSON.parse(raw),id=claim.id;
  const s = staff_(id);
  if (!s.length) throw Error('Rekod staf tidak ditemui.');
  const obj = userRow_(id);
  if(!obj.row || obj.row[3]!=='AKTIF' || obj.row[5]!==claim.hash)throw Error('Sesi tidak sah. Sila log masuk semula.');
  let role = obj.row && obj.row[1] ? obj.row[1] : 'STAF';
  let scope = obj.row && obj.row[2] ? obj.row[2] : s[0][2];
  let modules = obj.row && obj.row[6] ? obj.row[6] : '';
  
  let mSet = new Set(modules.split(',').map(x=>x.trim()).filter(Boolean));

  // KETUA JABATAN & KETUA UNIT AUTOMATIK JADI PENYOKONG BDR & UR JABATAN MEREKA
  if (['KETUA JABATAN', 'KETUA UNIT'].includes(role)) {
    mSet.add('SOKONG_BDR');
    mSet.add('SOKONG_UR');
  }

  // PENGURUSAN (PENGARAH / TIMBALAN PENGARAH) AUTOMATIK DAPAT AKSES WARGA & KELULUSAN JIKA BELUM DITETAPKAN
  if (role === 'PENGURUSAN') {
    scope = 'SEMUA';
    mSet.add('SOKONG_BDR');
    mSet.add('LULUS_BDR');
    mSet.add('SOKONG_UR');
    mSet.add('LULUS_UR');
    mSet.add('ANALISA');
    mSet.add('ANALISA_WARGA');
  }

  modules = [...mSet].join(',');
  const sign = obj.row ? obj.row[7] : '';
  const stamp = obj.row ? obj.row[8] : '';
  
  return { id, name: s[0][1], role, scope, unit: s[0][2], jawatan: s[0][3], gred: s[0][4], modules, sign, stamp };
}

function logout(token){CacheService.getScriptCache().remove('sess_'+norm_(token));return true;}

function checkAccess_(u, moduleCode) {
  if (['SUPER ADMIN HIDDEN', 'SUPER ADMIN'].includes(u.role)) return true;
  const mods = String(u.modules || '').split(',').map(x => x.trim()).filter(Boolean);
  if (mods.includes('SEMUA')) return true;
  if (['KETUA JABATAN', 'KETUA UNIT'].includes(u.role) && ['SOKONG_BDR', 'SOKONG_UR'].includes(moduleCode)) return true;
  if (u.role === 'PENGURUSAN' && ['SOKONG_BDR', 'LULUS_BDR', 'SOKONG_UR', 'LULUS_UR', 'ANALISA', 'ANALISA_WARGA'].includes(moduleCode)) return true;
  if (moduleCode === 'ANALISA' && mods.includes('ANALISA_WARGA')) return true;
  return mods.includes(moduleCode);
}

// SKOP DATA DASHBOARD & ANALISA (SOKONG ANALISA KESELURUHAN WARGA & JABATAN)
function within_(u, p) {
  if (['SUPER ADMIN HIDDEN', 'SUPER ADMIN', 'PENGURUSAN'].includes(u.role)) return true;
  const mods = String(u.modules || '').split(',').map(x => x.trim());
  // Jika Admin diberi lencana ANALISA_WARGA atau LULUS_BDR / LULUS_UR atau skop SEMUA, benarkan lihat keseluruhan warga & jabatan
  if (u.scope === 'SEMUA' || mods.includes('ANALISA_WARGA') || mods.includes('LULUS_BDR') || mods.includes('LULUS_UR') || mods.includes('DB') || mods.includes('ROLE')) {
    return true;
  }
  if (['KETUA JABATAN', 'KETUA UNIT', 'ADMIN'].includes(u.role) || mods.includes('ANALISA') || mods.includes('SOKONG_BDR') || mods.includes('SOKONG_UR')) {
    const targetUnit = (u.scope && u.scope !== 'SEMUA') ? u.scope : u.unit;
    return p.unit === targetUnit || p.unit === u.unit;
  }
  return p.id === u.id;
}

function changeUserPassword(changeToken,oldPass,newPass,confirmPass){
 return locked_(()=>{
  assertReady_();const cache=CacheService.getScriptCache(),key='change_'+norm_(changeToken),raw=cache.get(key);
  if(!raw)throw Error('Pautan tukar kata laluan tamat. Log masuk semula.');
  const claim=JSON.parse(raw),obj=userRow_(claim.id),r=obj.row;
  if(!r || r[5]!==claim.hash || !['AKTIF','MENUNGGU PIN'].includes(r[3]) || !verifyPin_(String(oldPass||''),r))throw Error('Kata laluan semasa tidak sah.');
  newPass=String(newPass||'');
  if(newPass!==String(confirmPass||'') || newPass.length<6 || newPass===String(oldPass))throw Error('Gunakan kata laluan baharu sekurang-kurangnya 6 aksara dan pengesahan yang sama.');
  r[4]=uuid_();r[5]=hash_(newPass,r[4]);r[12]='TIDAK';r[3]='AKTIF';r[9]=0;r[10]='';
  setRow_(obj.sh,obj.idx,r);cache.remove(key);return {ok:true};
 });
}

function userRequestReset(id){
 return locked_(()=>{
