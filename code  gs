function getMyForms(token) {
  const u = session_(token);
  const bdrSh = sheet_('BORANG_BDR');
  const urSh = sheet_('BORANG_UR');
  let myBDR = [], myUR = [];
  
  if (bdrSh) {
     myBDR = rows_(bdrSh, 20).filter(r => r[2] === u.id).map(r => ({
      reqId: r[0], tMohon: r[1], name: r[3], unit: r[4], jawatan: r[5], gred: r[6], mula: r[7], akhir: r[8], telefon: r[9], sebab: r[10], alamat: r[11],
      statusSokong: r[12], idSokong: r[13], ulasanSokong: r[14], tSokong: r[15], statusLulus: r[16], idLulus: r[17], ulasanLulus: r[18], tLulus: r[19]
    })).reverse(); 
  }
  if (urSh) {
     myUR = rows_(urSh, 23).filter(r => r[2] === u.id).map(r => ({
      reqId: r[0], tMohon: r[1], name: r[3], unit: r[4], jawatan: r[5], gred: r[6], perihal: r[7], mula: r[8], akhir: r[9], lokasi: r[10], tempatLuar: r[11], rujukan: r[12], tarikhSurat: r[13], diminitkan: r[14],
      statusSokong: r[15], idSokong: r[16], ulasanSokong: r[17], tSokong: r[18], statusLulus: r[19], idLulus: r[20], ulasanLulus: r[21], tLulus: r[22]
    })).reverse();
  }
  
  const userDB = rows_(sheet_('PENGGUNA'), 13);
  const sigMap = new Map(userDB.map(r => [r[0], {sign: r[7], stamp: r[8]}]));
  const stafDetails = new Map(masterStaff_().map(s => [s.id, {nama: s.name, jwt: s.jawatan+' '+s.gred}]));

  const injectSig = (form) => {
     form.mySign = sigMap.get(u.id)?.sign || '';
     if (form.statusSokong === 'DISOKONG' && form.idSokong) { 
       form.sokongSign = sigMap.get(form.idSokong)?.sign || ''; form.sokongStamp = sigMap.get(form.idSokong)?.stamp || ''; 
       form.namaSokong = stafDetails.get(form.idSokong)?.nama || form.idSokong; form.jwtSokong = stafDetails.get(form.idSokong)?.jwt || '';
     }
     if (form.statusLulus === 'DILULUSKAN' && form.idLulus) { 
       form.lulusSign = sigMap.get(form.idLulus)?.sign || ''; form.lulusStamp = sigMap.get(form.idLulus)?.stamp || ''; 
       form.namaLulus = stafDetails.get(form.idLulus)?.nama || form.idLulus; form.jwtLulus = stafDetails.get(form.idLulus)?.jwt || '';
     }
  };
  myUR.forEach(injectSig); myBDR.forEach(injectSig);
  return { bdr: myBDR, ur: myUR };
}

function adminGetPendingBDR(token) {
  const u = session_(token);
  const canSokong = checkAccess_(u, 'SOKONG_BDR');
  const canLulus = checkAccess_(u, 'LULUS_BDR');
  if (!canSokong && !canLulus) return {sokong:[], lulus:[]};
  
  const sh = sheet_('BORANG_BDR'); if(!sh) return {sokong:[], lulus:[]};
  const rs = rows_(sh, 20);
  const nameMap = new Map(masterStaff_().map(s => [s.id, s.name]));
  const isGlobal = u.scope === 'SEMUA' || ['SUPER ADMIN', 'SUPER ADMIN HIDDEN', 'PENGURUSAN'].includes(u.role) || checkAccess_(u, 'ANALISA_WARGA') || canLulus;
  const myUnitScope = (u.scope && u.scope !== 'SEMUA') ? u.scope : u.unit;

  let sokongList = [], lulusList = [];
  if (canSokong) {
    sokongList = rs.filter(r => r[12] === 'MENUNGGU SOKONGAN' && (isGlobal || r[4] === myUnitScope || r[4] === u.unit)).map(r => ({
      reqId: r[0], tMohon: r[1], name: r[3], unit: r[4], jawatan: r[5], mula: r[7], akhir: r[8], sebab: r[10]
    }));
  }
  if (canLulus) {
    lulusList = rs.filter(r => r[12] === 'DISOKONG' && r[16] === 'MENUNGGU KELULUSAN' && (isGlobal || r[4] === myUnitScope)).map(r => ({
      reqId: r[0], tMohon: r[1], name: r[3], unit: r[4], jawatan: r[5], mula: r[7], akhir: r[8], sebab: r[10], ulasanSokong: r[14], namaSokong: nameMap.get(r[13]) || r[13]
    }));
  }
  return { sokong: sokongList, lulus: lulusList };
}

function adminProcessBDR(token, reqId, type, statusSah, ulasan) {
  return locked_(()=>{
  const u = session_(token);
  const sh = sheet_('BORANG_BDR'), rs = rows_(sh, 20), ix = rs.findIndex(r => r[0] === reqId);
  if (ix < 0) throw Error('Borang BDR tidak ditemui.');
  const r = rs[ix];
  validateDecision_(u,r,"BDR",type,statusSah);
  
  if (type === 'SOKONG' && checkAccess_(u, 'SOKONG_BDR')) {
     r[12] = statusSah; r[13] = u.id; r[14] = String(ulasan||'').trim(); r[15] = new Date().toISOString();
     const recSh = sheet_('KEBERADAAN'), recRs = rows_(recSh, 6); let curr = r[7];
     while(curr <= r[8]) {
       const ixRec = recRs.findIndex(record => record[0] === r[2] && record[1] === curr);
       if (ixRec >= 0 && recRs[ixRec][2].includes('BDR') && recRs[ixRec][3].includes(reqId)) setRow_(recSh, ixRec+2, [r[2], curr, (statusSah === 'DISOKONG') ? 'BDR (Kelulusan)' : 'LAIN-LAIN', 'Rujuk borang: '+reqId+'; Status: '+statusSah, new Date(), u.id]);
