function getData(token){
  const u = session_(token);
  let rawStaf = masterStaff_().map(p=>({id:p.id,name:p.name,unit:p.unit,jawatan:p.jawatan}));
  try {
    const shStaf = sheet_('STAF');
    if (shStaf && shStaf.getLastRow() >= 2) {
      const dbStaf = rows_(shStaf, 7).filter(r=>r[0]&&r[1]&&r[6]!=='GUGUR').map(r=>({id:r[0],name:r[1],unit:r[2],jawatan:r[3]}));
      if (dbStaf.length > 0) rawStaf = dbStaf;
    }
  } catch(e) {}

  const people = rawStaf.filter(p=>within_(u,p));
  const ids = new Set(people.map(p=>p.id));
  let entries = [];
  try {
    entries = rows_(sheet_('KEBERADAAN'),6).filter(r=>ids.has(r[0])&&r[1]).map(r=>({id:r[0],date:r[1],status:r[2],note:r[3]}));
  } catch(e) {}
  
  let totalResets = 0;
  try {
    if(checkAccess_(u, 'ANALISA') || checkAccess_(u, 'ANALISA_WARGA') || ['KETUA JABATAN','KETUA UNIT'].includes(u.role)) {
       const users = rows_(sheet_('PENGGUNA'), 13);
       users.forEach(r => { totalResets += Number(r[11] || 0); }); 
    }
  } catch(e) {}

  return {
    user: u,
    people: people,
    entries: entries,
    dates: weekDays_(myToday_()),
    weekStart: monday_(myToday_()),
    statuses: CFG.STATUS,
    units: [...new Set(people.map(p=>p.unit))].sort(),
    totalResets: totalResets
  };
}

function saveStatus(payload,token){
 return locked_(()=>{
  const u=session_(token),p=payload||{},id=norm_(p.id),date=validDay_(p.date),status=norm_(p.status);
  canEditRecord_(u,id);
  if(!CFG.STATUS.includes(status)||/Sokongan|Kelulusan/.test(status))throw Error('Status tidak sah.');
  if(['BDR','UR'].includes(status)){
   const sh=sheet_(status==='BDR'?'BORANG_BDR':'BORANG_UR'),b=status==='BDR',rs=rows_(sh,b?20:23);
   if(!rs.some(r=>r[2]===id && date>=r[b?7:8] && date<=r[b?8:9] && r[b?16:19]==='DILULUSKAN'))throw Error('Hantar borang '+status+' dan tunggu kelulusan dahulu.');
  }
  upsertRecord_(id,date,status,safe_(norm_(p.note)),u.id);return {ok:true};
 });
}

function adminDeleteKeberadaan(token,targetId,targetDate){
 return locked_(()=>{
  const u=session_(token),id=norm_(targetId),dt=validDay_(targetDate);canEditRecord_(u,id);
  const sh=sheet_('KEBERADAAN'),rs=rows_(sh,6);
  for(let i=rs.length-1;i>=0;i--)if(rs[i][0]===id&&rs[i][1]===dt)sh.deleteRow(i+2);
  // Approval forms remain as the audit record; deleting one day never deletes a multi-day form.
  return {ok:true};
 });
}

function submitBorangBDR(token, p) {
  return locked_(()=>{
  const u = session_(token);
  validateForm_(u,p,"BDR");
  const sh = sheet_('BORANG_BDR');
 const reqId = 'BDR-' + uuid_(), tMohon = Utilities.formatDate(new Date(), 'Asia/Kuala_Lumpur', 'yyyy-MM-dd HH:mm:ss');
  sh.appendRow([ reqId, tMohon, u.id, u.name, u.unit, u.jawatan, u.gred, p.mula, p.akhir, p.telefon, p.sebab, p.alamat, 'MENUNGGU SOKONGAN', '', '', '', 'MENUNGGU KELULUSAN', '', '', '' ]);
  
  const recSh = sheet_('KEBERADAAN'), rs = rows_(recSh, 6);
  let curr = p.mula;
  while(curr <= p.akhir) {
    const dow = new Date(curr+'T12:00:00Z').getUTCDay();
    if (dow >= 1 && dow <= 5) {
      const ix = rs.findIndex(r => r[0] === u.id && r[1] === curr), v = [u.id, curr, 'BDR (Sokongan)', 'Rujuk Borang BDR: ' + reqId, new Date(), u.id];
      if (ix === -1) recSh.appendRow(v); else setRow_(recSh, ix+2, v);
    }
    curr = addDays_(curr, 1);
  }
  return { ok: true, reqId: reqId };
  });
}

