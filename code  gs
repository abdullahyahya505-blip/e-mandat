// SIMPAN PERANAN & HAPUSKAN BARIS PENDUA SUPAYA TETAPAN SUPER ADMIN SENTIASA TEPAT
function adminChangeUserRole(token, targetId, newRole, newScope, modules) {
  const u = session_(token);
  requireAdminTarget_(u,targetId);
  if (!checkAccess_(u, 'ROLE')) throw Error('Akses ditolak.');
  if(!u.role.includes('SUPER ADMIN'))throw Error('Hanya Super Admin boleh melantik peranan dan modul.');
  if(!['STAF','ADMIN','KETUA JABATAN','KETUA UNIT','PENGURUSAN','SUPER ADMIN'].includes(newRole))throw Error('Peranan tidak sah.');
  const cleanId = norm_(targetId).toUpperCase();
  const sh = sheet_('PENGGUNA');
  const rs = rows_(sh, Math.max(13,sh.getLastColumn()));
  
  let matchingRows = [];
  rs.forEach((r, idx) => {
    if (String(r[0]).trim().toUpperCase() === cleanId) matchingRows.push(idx + 2);
  });

  if (matchingRows.length === 0) {
    const st = masterStaff_().find(p => p.id === cleanId);
    if (!st) throw Error('Staf tidak ditemui.');
    const salt=uuid_();
    sh.appendRow([cleanId, norm_(newRole), norm_(newScope), 'AKTIF', salt, hash_('123456',salt), norm_(modules), '', '', 0, '', 0, 'YA']);
    return { ok: true };
  }

  // Kemas kini baris pertama dan padam sebarang baris pendua lama jika ada
  const keepRowIdx = matchingRows[matchingRows.length-1];
  const r = rs[keepRowIdx - 2];
  r[1] = norm_(newRole);
  r[2] = norm_(newScope);
  r[3] = r[3] || 'AKTIF';
  r[6] = norm_(modules);
  setRow_(sh, keepRowIdx, r);


  return { ok: true };
}

