 if(!p||!staff_(u.id).length)throw Error('Profil staf tidak sah.');
 p.mula=validDay_(p.mula);p.akhir=validDay_(p.akhir);
 if(p.akhir<p.mula||(Date.parse(p.akhir)-Date.parse(p.mula))/86400000>366)throw Error('Julat tarikh tidak sah atau melebihi 366 hari.');
 if(!norm_(kind==='BDR'?p.sebab:p.perihal))throw Error('Sebab/perihal wajib diisi.');
